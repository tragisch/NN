# ── Build artifacts ──────────────────────────────────────────────
*.d *.o *.ko *.obj *.elf
*.ilk *.map *.exp
*.gch *.pch
*.lib *.a *.la *.lo
*.dll *.so *.so.* *.dylib
*.exe *.out *.app *.i*86 *.x86_64 *.hex
*.dSYM/ *.su *.idb *.pdb
*.mod* .tmp_versions/ modules.order Module.symvers Mkfile.old dkms.conf

# Bazel
/bazel-*
/bazel.iml
/output/
user.bazelrc
MODULE.bazel.lock
.bazelccrc
compile_commands.json

# ── Editor / OS ──────────────────────────────────────────────────
.DS_Store .AppleDouble .LSOverride ._* Icon
.DocumentRevisions-V100 .fseventsd .Spotlight-V100 .TemporaryItems
.Trashes .VolumeIcon.icns .com.apple.timemachine.donotpresent
.AppleDB .AppleDesktop .apdisk
.vscode/*
.history/
*.vsix
/tmp/*

# ── Local caches and tool state ──────────────────────────────────
/.cache/
/.grail-db/
/.bgai-db/
/coverage/*
/data/*
/lib/*
_archive/*

# ── Generated / tool-specific files ──────────────────────────────
*.in
*.clang-tidy
*.png
StyleGuide.md

# Data and generated model artifacts
*.ubyte
*.ubyte.gz
*.bin
*.aimodel
*.graphir.json
runner_bin
combined_runner.rs
mnist_generated.rs
mnist_coreai.py

# MNIST / Fashion-MNIST raw data (download locally, do not commit)
examples/**/*-idx[13]-ubyte
examples/**/*-idx[13]-ubyte.gz

# Internal agent instructions (not for public repo)
.github/instructions/
.github/skills/

# Benchmark results and history (keep code, ignore output)
share/**/results/
share/**/history/

# Keep the modulemap exception
!app/nm_lib/include/module.modulemap
