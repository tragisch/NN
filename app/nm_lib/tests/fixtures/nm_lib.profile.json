{
  "profile_version": 1,
  "backend": "nm_lib",
  "graphir": {"format_versions": [3, 4], "opset_versions": [1, 2, 3]},
  "dtypes": ["float32", "bfloat16", "float16", "int64", "bool"],
  "promoted_dtypes": ["bfloat16", "float16"],
  "supports_quantization": false,
  "supports_external_weights": true,
  "requires_constant_data": true,
  "operations": [
    {"name": "Input"},
    {"name": "Constant"},
    {"name": "MatMul", "rules": ["float_inputs"]},
    {"name": "Add", "rules": ["float_inputs"]},
    {"name": "Sub", "rules": ["float_inputs"]},
    {"name": "Mul", "rules": ["float_inputs"]},
    {"name": "Div", "rules": ["float_inputs"]},
    {"name": "ReLU", "rules": ["float_inputs"]},
    {"name": "Sigmoid", "rules": ["float_inputs"]},
    {"name": "Tanh", "rules": ["float_inputs"]},
    {"name": "GELU", "rules": ["float_inputs"]},
    {"name": "Softmax", "rules": ["last_axis", "float_inputs"]},
    {"name": "LayerNorm", "rules": ["float_inputs"]},
    {"name": "Conv2D",
     "attributes": {"dilations": {"allowed": [[1, 1]]},
                     "groups": {"allowed": [1]}},
     "rules": ["symmetric_pads", "float_inputs"]},
    {"name": "MaxPool2D", "rules": ["symmetric_pads", "float_inputs"]},
    {"name": "Reshape"},
    {"name": "Transpose"},
    {"name": "Gather"},
    {"name": "Equal"},
    {"name": "Not"},
    {"name": "Where"},
    {"name": "Cast"},
    {"name": "Expand"},
    {"name": "Slice"},
    {"name": "ReduceMax", "rules": ["float_inputs"]},
    {"name": "Range"},
    {"name": "Squeeze"},
    {"name": "Unsqueeze"}
  ]
}
